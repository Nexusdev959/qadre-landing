{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Landing pública en qadre.net (la app va aparte en app.qadre.net, Worker "qadre")
  "name": "qadre-landing",
  "compatibility_date": "2024-11-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist/qadre-landing/browser",
    "not_found_handling": "single-page-application"
  }
}
